{
  "name": "RailDrop — know when your train gets cheaper",
  "short_name": "RailDrop",
  "description": "RailDrop watches Amtrak fares after you have already bought a ticket, and tells you when a materially cheaper option appears on your route.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#fbfaf8",
  "theme_color": "#14120f",
  "categories": ["travel", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Watch a trip", "short_name": "New trip", "url": "/watches/new", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Your trips", "short_name": "Trips", "url": "/dashboard", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
