{
  "name": "raildrop",
  "version": "1.0.0",
  "private": true,
  "description": "RailDrop \u2014 know when your train gets cheaper.",
  "scripts": {
    "dev": "next dev",
    "demo": "NEXT_DIST_DIR=.next-demo E2E_MODE=true FARE_PROVIDER=deterministic RAILDROP_ALLOW_TEST_PROVIDER=i-understand-this-is-not-production NEXT_PUBLIC_SUPABASE_URL=http://demo.invalid NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-anon-key-placeholder NEXT_PUBLIC_APP_URL=http://localhost:3000 next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --dir scripts --dir tests",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "e2e": "next build && playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:all && npm run build && npm run check:secrets && npm run check:budget",
    "check:secrets": "tsx --tsconfig tsconfig.scripts.json scripts/check-bundle-secrets.ts",
    "check:budget": "tsx --tsconfig tsconfig.scripts.json scripts/check-bundle-budget.ts",
    "probe:provider": "tsx --tsconfig tsconfig.scripts.json scripts/probe-provider.ts",
    "verify:party-pricing": "tsx --tsconfig tsconfig.scripts.json scripts/verify-party-pricing.ts",
    "verify:booking-links": "tsx --tsconfig tsconfig.scripts.json scripts/verify-booking-links.ts",
    "email:test": "tsx --tsconfig tsconfig.scripts.json scripts/send-test-email.ts",
    "db:push": "tsx --tsconfig tsconfig.scripts.json scripts/db-push.ts",
    "db:verify": "tsx --tsconfig tsconfig.scripts.json scripts/db-verify.ts",
    "gen:cron-secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
    "refresh:stations": "tsx --tsconfig tsconfig.scripts.json scripts/refresh-stations.ts",
    "visual": "VISUAL_QA=1 next build && VISUAL_QA=1 playwright test --project=desktop e2e/visual",
    "verify:live": "tsx --tsconfig tsconfig.scripts.json scripts/verify-live.ts",
    "gen:icons": "tsx --tsconfig tsconfig.scripts.json scripts/gen-icons.ts",
    "gen:vapid": "tsx --tsconfig tsconfig.scripts.json scripts/gen-vapid.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "pg": "^8.23.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
