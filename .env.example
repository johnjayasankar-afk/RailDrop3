# RailDrop environment. Names only — never commit values.
# Copy to .env.local and fill in. See SETUP_REQUIRED.md.

# ── Origin ───────────────────────────────────────────────────────────────────
# Every absolute URL the product emits is built from this: canonical metadata,
# the sitemap, robots, and the CTA in an alert email. On Vercel it falls back to
# VERCEL_PROJECT_PRODUCTION_URL, and then to http://localhost:3000. Set it
# explicitly in production, or the first alerts link somewhere that is not you.
NEXT_PUBLIC_APP_URL=

# ── Supabase ─────────────────────────────────────────────────────────────────
# The anon key is the only one the browser ever sees. The service role key is
# server-only and must never appear in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Fare providers ───────────────────────────────────────────────────────────
# Wanderu (headless Chromium) is primary and needs no key. Parse is the
# fallback; without PARSE_API_KEY there is no secondary provider at all.
PARSE_API_KEY=
PARSE_SCRAPER_ID=

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=

# ── Scheduling ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Presented as `Authorization: Bearer $CRON_SECRET`. Never as a query string:
# that puts the secret in access logs, referrers and browser history.
# It also gates /api/health/provider?probe=1, which spends provider credits.
CRON_SECRET=

# ── Budget ───────────────────────────────────────────────────────────────────
PROVIDER_CREDITS_PER_SEARCH=
PROVIDER_MONTHLY_CREDIT_BUDGET=

# ── Local development only ───────────────────────────────────────────────────
# getConfig() throws if either is set in production.
RAILDROP_LOCAL=
NEXT_PUBLIC_RAILDROP_LOCAL=
E2E_TEST=

# Direct Postgres, so the app can apply its own schema.
#
# Optional. Without it everything works as before, minus self-setup: the app
# can tell you the tables are missing and cannot do anything about it, because
# supabase-js talks to PostgREST and PostgREST cannot run DDL.
#
# Supabase -> Project Settings -> Database -> Connection string -> the pooled
# URI. Vercel's Supabase integration sets POSTGRES_URL, which is also accepted.
# Then: curl -X POST https://<deployment>/api/admin/setup-database \
#            -H "Authorization: Bearer $CRON_SECRET"
SUPABASE_DB_URL=
